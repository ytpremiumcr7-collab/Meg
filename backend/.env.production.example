# Copy to .env.production; never commit the populated file.
ENVIRONMENT=production
SECRET_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
DATABASE_URL=postgresql+asyncpg://megalodon:${POSTGRES_PASSWORD}@db:5432/megalodon
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_BACKEND_ENDPOINT=
OTEL_BACKEND_AUTH_HEADER=
OTEL_SERVICE_NAME=megalodon-api
REDIS_FAILURE_POLICY=closed
CORS_ALLOWED_ORIGINS=https://app.example.com
