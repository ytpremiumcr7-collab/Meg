# Database
DATABASE_URL=postgresql+asyncpg://megalodon:megalodon@localhost:5432/megalodon

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO / S3 (legado, ver nota en app/config.py -- Supabase es la ruta activa)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=megalodon
S3_SECRET_KEY=megalodon123
S3_BUCKET=megalodon-uploads

# Supabase Storage (usa la service role key, NO la anon key -- el backend
# actúa como identidad de servicio de confianza, no como usuario final)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key
SUPABASE_BUCKET_BIM=bim-modelos
SUPABASE_BUCKET_DOCUMENTOS=documentos
SUPABASE_BUCKET_EXPORTS=exportaciones

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Mexican Legal Constants
TASA_TIE_REFERENCIA=0.1125
PRECIO_DIESEL_REFERENCIA=24.50

# FSR Sources
INEGI_PRECIOS_URL=https://www.inegi.org.mx/app/indicesdeprecios/
BANXICO_UDIS_URL=https://www.banxico.org.mx/tipcamb/main.do
CONASAMI_SALARIOS_URL=https://www.conasami.gob.mx

# SAT / IMSS / INFONAVIT
SAT_WS_URL=https://consulta.sat.gob.mx
IMSS_WS_URL=https://serviciosdigitales.imss.gob.mx
INFONAVIT_WS_URL=https://portal.infonavit.org.mx

# Feature Flags
FEATURE_BIM_VIEWER=true
FEATURE_OCR_METRADOS=true
FEATURE_BLOCKCHAIN_AUDIT=false
FEATURE_AI_ASSISTANT=false
