# TU-OSINT Platform Environment Configuration

# ─── Security ───
JWT_SECRET_KEY=change-this-in-production-min-32-chars-long
AGENT_HMAC_SECRET=change-this-too
API_KEY_MASTER=your-master-api-key

# ─── Database ───
DATABASE_URL=sqlite:///./osint_platform.db
# DATABASE_URL=postgresql://user:pass@localhost/osint_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── CORS ───
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Cookies ───
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ─── Rate Limiting ───
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ─── External API Keys ───
# Shodan
SHODAN_API_KEY=
# Censys
CENSYS_API_ID=
CENSYS_API_SECRET=
# GreyNoise
GREYNOISE_API_KEY=
# OpenSky
OPENSKY_USER=
OPENSKY_PASS=
# ADS-B Exchange
ADSBEXCHANGE_API_KEY=
# AVWX
AVWX_API_KEY=
# NASA Earthdata
NASA_USERNAME=
NASA_PASSWORD=
# Copernicus
COPERNICUS_USER=
COPERNICUS_PASS=
# GraphHopper
GRAPHHOPPER_API_KEY=
# WebODM
WEBODM_URL=http://localhost:8000
WEBODM_TOKEN=
WEBODM_UPLOAD_DIR=/tmp/webodm_uploads

# ─── Deployment ───
ENVIRONMENT=development
# ENVIRONMENT=production

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FILE=/var/log/tu-osint/app.log

# ─── Sentry (optional) ───
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# ─── Secure Requests ───
REQUEST_USER_AGENT=TU-OSINT-Platform/2.3.5 (Research Project; security@example.com)
REQUEST_TIMEOUT=30
REQUEST_MAX_RETRIES=3
REQUEST_JITTER_MIN=1.0
REQUEST_JITTER_MAX=3.0

# ─── Cache TTLs (seconds) ───
CACHE_TTL_MALWARE=7200
CACHE_TTL_CISA_KEV=21600
CACHE_TTL_OSINT=3600

# ─── VPN (WireGuard) ───
# Usa VPN para ocultar tu IP real en requests a APIs externas
# 1. Configura WireGuard: bash setup-vpn.sh
# 2. O usa docker-compose con el servicio vpn descomentado
# 3. Verifica: curl https://ipinfo.io
# VPN_ENABLED=false
